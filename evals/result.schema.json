{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/audit-problem-classifier/evals/result.schema.json",
  "title": "Audit Problem Classifier Machine Result V2.2.3",
  "type": "object",
  "required": [
    "id",
    "contract_version",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "2.2.3"
    },
    "text": {
      "type": "string"
    },
    "gate_status": {
      "enum": [
        "proceed",
        "blocked",
        "needs_review"
      ]
    },
    "category": {
      "enum": [
        "ZD",
        "YS",
        "ZJ",
        "ZC",
        "CG",
        "XM",
        "FY",
        "SJ",
        "KJ",
        "NK",
        "SW",
        "QT"
      ]
    },
    "finding_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conclusion_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applicability_status": {
      "enum": [
        "applicable",
        "not_applicable",
        "needs_review"
      ]
    },
    "law_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_law_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "voucher_total": {
      "type": "number",
      "minimum": 0
    },
    "law_roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "enum": [
          "direct_basis",
          "supporting_basis",
          "liability_basis"
        ]
      }
    },
    "report_mode": {
      "enum": [
        "classification_report",
        "special_audit_report"
      ]
    },
    "report_sections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applicability_target": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit identity of the single rule/candidate that applicability_status refers to. Must be emitted together with applicability_status (schema-enforced bidirectionally). Either a structured Law ID (then membership in law_ids/excluded_law_ids is enforced by status) or a stable candidate_rule identifier declared in the case input context."
    },
    "fact_grounding": {
      "type": "array",
      "description": "V2.2.3 fact-grounding records: each guarded conclusion code must be licensed by facts whose citations appear verbatim in the source input.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "citation"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "citation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit_objects": {
      "type": "array",
      "description": "V2.2.4 evidence-grounded audit objects (typed candidates + deterministic gate authorization). SW invoice findings require at least one authorized_sw invoice_compliance object whose assertion quotes verify verbatim against the source input (scorer enforces globally).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "object_kind",
          "directness",
          "decision",
          "assertions"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "object_kind": {
            "type": "string",
            "enum": [
              "expense_reimbursement",
              "invoice_compliance",
              "tax_obligation"
            ]
          },
          "directness": {
            "type": "string",
            "enum": [
              "primary",
              "incidental"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "candidate",
              "authorized_sw",
              "incidental_fy",
              "needs_review",
              "no_invoice_finding",
              "rejected"
            ],
            "description": "'candidate' = runtime proposal awaiting gate authorization; the other values are deterministic gate outputs."
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assertion_kind",
                "polarity",
                "source_id",
                "quote"
              ],
              "properties": {
                "assertion_kind": {
                  "type": "string",
                  "enum": [
                    "invoice_buyer_mismatch",
                    "issuer_payee_mismatch",
                    "noncompliant_invoice_obtained",
                    "invoice_information_irregular_fact",
                    "explicit_invoice_characterization_request",
                    "explicit_invoice_legality_question",
                    "true_transaction",
                    "false_invoicing_evidence_absent"
                  ]
                },
                "polarity": {
                  "type": "string",
                  "enum": [
                    "affirmative",
                    "negative",
                    "hypothetical"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "enum": [
                    "prompt",
                    "context"
                  ],
                  "description": "Immutable source snippet the quote was taken from; 'expected' or any other id is illegal."
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "dependentRequired": {
    "applicability_status": [
      "applicability_target"
    ],
    "applicability_target": [
      "applicability_status"
    ]
  }
}
