{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/audit-problem-classifier/schemas/law.schema.json",
  "title": "Audit Law Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "issuer",
    "legal_level",
    "status",
    "jurisdiction",
    "rule_role",
    "text",
    "source",
    "verified_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "document_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "article": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "legal_level": {
      "enum": [
        "law",
        "administrative_regulation",
        "department_rule",
        "normative_document",
        "local_regulation",
        "party_rule",
        "accounting_standard",
        "other"
      ]
    },
    "status": {
      "enum": [
        "effective",
        "repealed",
        "superseded",
        "pending",
        "unknown"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2
        },
        "province": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "county": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "subject_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "organization_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "person_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "business_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "funding_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "rule_role": {
      "enum": [
        "direct_basis",
        "supporting_basis",
        "liability_basis"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "applies_if": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "in",
              "not_in",
              "exists",
              "gte",
              "lte"
            ]
          },
          "value": {}
        }
      }
    },
    "excludes_if": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "in",
              "not_in",
              "exists",
              "gte",
              "lte"
            ]
          },
          "value": {}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "authority",
        "verified"
      ],
      "properties": {
        "type": {
          "enum": [
            "official",
            "official_archive",
            "secondary"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "effective"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "effective_from"
        ],
        "properties": {
          "effective_from": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "repealed",
              "superseded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "effective_from",
          "effective_to"
        ],
        "properties": {
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "effective_to": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
